# GitHub CLI configuration belongs to this checkout.
export GH_CONFIG_DIR="$PWD/.direnv/gh"
export GH_HOST="github.com"
export GH_REPO="matiasbinagora/media-traffic"

# Environment tokens override gh's saved login; isolate inherited credentials.
unset GH_TOKEN GITHUB_TOKEN

(umask 077; mkdir -p "$GH_CONFIG_DIR")
chmod 700 "$GH_CONFIG_DIR"

# Prefer the repository's pinned tools, including the agents-cli MCP command.
PATH_add "$PWD/node_modules/.bin"
